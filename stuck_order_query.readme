.\g3a.exe --input=funneling.parquet ^
  --select="case when grouping(region)=1 then 'Grand Total' when grouping(branch)=1 then region else '  ' || branch end as 'REG/BRANCH', count(1) filter (where mapping_kategori='PENDING' and periode=6 and mapping_order_new='DO') as 'PENDING/6/DO', count(1) filter (where mapping_kategori='PENDING' and periode=6 and mapping_order_new='MO') as 'PENDING/6/MO', count(1) filter (where mapping_kategori='PENDING' and periode=6 and mapping_order_new='PDA') as 'PENDING/6/PDA', count(1) filter (where mapping_kategori='PENDING' and periode=6) as 'PENDING/6/6 Total', count(1) filter (where mapping_kategori='PENDING' and periode=7 and mapping_order_new='DO') as 'PENDING/7/DO', count(1) filter (where mapping_kategori='PENDING' and periode=7 and mapping_order_new='MO') as 'PENDING/7/MO', count(1) filter (where mapping_kategori='PENDING' and periode=7 and mapping_order_new='PDA') as 'PENDING/7/PDA', count(1) filter (where mapping_kategori='PENDING' and periode=7) as 'PENDING/7/7 Total', count(1) filter (where mapping_kategori='PENDING' and periode=8 and mapping_order_new='DO') as 'PENDING/8/DO', count(1) filter (where mapping_kategori='PENDING' and periode=8 and mapping_order_new='MO') as 'PENDING/8/MO', count(1) filter (where mapping_kategori='PENDING' and periode=8 and mapping_order_new='PDA') as 'PENDING/8/PDA', count(1) filter (where mapping_kategori='PENDING' and periode=8) as 'PENDING/8/8 Total', printf('%.2f%%', 100.0 * count(1) filter (where mapping_kategori='COMPLETED' and periode=8) / nullif(count(1) filter (where mapping_kategori in ('COMPLETED','PENDING') and periode=8), 0)) as '%Progress MTD', count(1) filter (where mapping_kategori='PENDING') as 'TOTAL PENDING', count(1) filter (where mapping_kategori='CANCELLED') as 'TOTAL CANCELLED', count(1) filter (where mapping_kategori='COMPLETED') as 'TOTAL COMPLETED', count(1) as 'TOTAL ORDER', printf('%.2f%%', 100.0 * count(1) filter (where mapping_kategori='COMPLETED') / nullif(count(1) filter (where mapping_kategori in ('COMPLETED','PENDING')), 0)) as '%Progress Last 3 Months'" ^
  --where="periode in (6,7,8)" ^
  --group-by="ROLLUP(region, branch)" ^
  --order-by="grouping(region) asc, case region when 'SUMBAGUT' then 1 when 'SUMBAGTENG' then 2 when 'SUMBAGSEL' then 3 else 4 end, grouping(branch) desc, branch" ^
  --output=png ^
  --out-file=funneling_pivot_pending.png


pakai ini jika user menanyakan summary stuck order 3 bulan terakhir, kamu bisa sesuaikan bulannya